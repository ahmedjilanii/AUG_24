{
  "name" : "Appointment",
  "description" : "Represents a scheduled or requested appointment between a patient and a doctor.",
  "ownership" : "user",
  "acl" : {
    "admin" : [ "create", "read", "update", "delete" ],
    "patient" : [ "create", "read", "update", "delete" ],
    "doctor" : [ "read", "update" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "tenantId",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "description" : "Tenant ID for multi-tenancy."
  }, {
    "name" : "idOfUser",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "representsOwnership" : true,
    "createOnly" : true,
    "description" : "Owning patient — set automatically on create from the authenticated user; only the owning patient or an admin may update/delete."
  }, {
    "name" : "patientProfileId",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "description" : "Foreign key to the PatientProfile entity."
  }, {
    "name" : "doctorProfileId",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "description" : "Foreign key to the DoctorProfile entity."
  }, {
    "name" : "appointmentDate",
    "type" : "date",
    "required" : true,
    "indexed" : true,
    "description" : "Date of the appointment."
  }, {
    "name" : "appointmentTime",
    "type" : "string",
    "length" : 50,
    "required" : true,
    "description" : "Time of the appointment (e.g., '10:00 AM')."
  }, {
    "name" : "status",
    "type" : "string",
    "length" : 50,
    "indexed" : true,
    "enumValues" : "pending,confirmed,cancelled,completed,rescheduled",
    "defaultValue" : "pending",
    "description" : "Current status of the appointment."
  }, {
    "name" : "reasonForVisit",
    "type" : "string",
    "length" : 255,
    "required" : true,
    "searchable" : true,
    "description" : "Patient's reason for the visit."
  }, {
    "name" : "notes",
    "type" : "text",
    "listHidden" : true,
    "description" : "Doctor's notes or additional details about the appointment."
  }, {
    "name" : "type",
    "type" : "string",
    "length" : 50,
    "enumValues" : "consultation,follow_up,check_up,emergency",
    "description" : "Type of appointment."
  } ]
}