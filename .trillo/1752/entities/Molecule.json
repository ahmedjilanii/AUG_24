{
  "name" : "Molecule",
  "description" : "Represents a single project or event managed within the system.",
  "acl" : {
    "admin" : [ "create", "read", "update", "delete" ],
    "leadPoint" : [ "create", "read", "update", "delete" ],
    "stump" : [ "read" ],
    "user" : [ "read" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "name",
    "type" : "string",
    "length" : 100,
    "required" : true,
    "indexed" : true,
    "naming" : true,
    "searchable" : true,
    "description" : "The name of the Molecule (project or event)."
  }, {
    "name" : "description",
    "type" : "text",
    "searchable" : true,
    "listHidden" : true,
    "description" : "A detailed description of the Molecule."
  }, {
    "name" : "status",
    "type" : "string",
    "length" : 50,
    "indexed" : true,
    "enumValues" : "active,completed,archived",
    "defaultValue" : "active",
    "description" : "The current status of the Molecule."
  }, {
    "name" : "leadPointId",
    "type" : "long",
    "indexed" : true,
    "required" : true,
    "description" : "The ID of the User (Lead Point) responsible for this Molecule."
  } ]
}